    pub fn rename(&self, page: &FilePageHandle, id: String, new_name: String) -> Result<FileData, ServiceError> {
        let session = self.root.session()?;
        let entry = page
            .page
            .files
            .iter()
            .find(|record| record.id == id)
            .ok_or_else(|| ServiceError::new(ServiceErrorKind::InvalidInput))?;
        let record = self
            .root
            .runtime
            .block_on(self.root.client.rename_entry(&session, entry.wire(), &new_name))
            .map_err(map_client_error)?;
        Ok(FileData::from(&record))
    }

    pub fn move_entry(
        &self,
        page: &FilePageHandle,
        id: String,
        parent_id: Option<String>,
    ) -> Result<FileData, ServiceError> {
        let session = self.root.session()?;
        let entry = page
            .page
            .files
            .iter()
            .find(|record| record.id == id)
            .ok_or_else(|| ServiceError::new(ServiceErrorKind::InvalidInput))?;
        let record = self
            .root
            .runtime
            .block_on(self.root.client.move_entry(&session, entry.wire(), parent_id))
            .map_err(map_client_error)?;
        Ok(FileData::from(&record))
    }

    pub fn trash(&self, id: String) -> Result<(), ServiceError> {
        self.root.session()?;
        let entry = self
            .root
            .runtime
            .block_on(self.root.client.get_file(&id))
            .map_err(map_client_error)?;
        self.root
            .runtime
            .block_on(self.root.client.trash_entry(&entry))
            .map_err(map_client_error)
    }

    pub fn restore(&self, id: String) -> Result<(), ServiceError> {
        self.root.session()?;
        let entry = self
            .root
            .runtime
            .block_on(self.root.client.get_file(&id))
            .map_err(map_client_error)?;
        self.root
            .runtime
            .block_on(self.root.client.restore_entry(&entry))
            .map_err(map_client_error)
    }

    pub fn restore_version(
        &self,
        store: Arc<StoreHandle>,
        file_id: String,
        version_id: String,
    ) -> Result<Option<u64>, ServiceError> {
        let session = self.root.session()?;
        self.root
            .runtime
            .block_on(self.root.client.restore_version(
                &session,
                &store.store,
                &file_id,
                &version_id,
            ))
            .map(|result| result.counter)
            .map_err(map_client_error)
    }

    pub fn delete_forever(&self, id: String) -> Result<(), ServiceError> {
        self.root.session()?;
        let entry = self
            .root
            .runtime
            .block_on(self.root.client.get_file(&id))
            .map_err(map_client_error)?;
        self.root
            .runtime
            .block_on(self.root.client.delete_entry_forever(&entry))
            .map_err(map_client_error)
    }
}

#[derive(Debug, Clone, uniffi::Record)]
pub struct DeviceData {
    pub id: String,
    pub hostname: String,
    pub platform: String,
    pub version: Option<String>,
    pub last_seen: String,
    pub created_at: String,
}

#[derive(uniffi::Object)]
pub struct DeviceServiceHandle {
    pub(crate) root: Arc<NativeClientHandle>,
}

#[uniffi::export]
impl DeviceServiceHandle {
    pub fn list(&self) -> Result<Vec<DeviceData>, ServiceError> {
        self.root
            .runtime
            .block_on(self.root.client.list_devices())
            .map(|result| {
                result
                    .devices
                    .into_iter()
                    .map(|device| DeviceData {
                        id: device.id,
                        hostname: device.hostname,
                        platform: device.platform,
                        version: device.bb_version,
                        last_seen: device.last_seen,
                        created_at: device.created_at,
                    })
                    .collect()
            })
            .map_err(map_client_error)
    }

    pub fn remove(&self, id: String) -> Result<(), ServiceError> {
        self.root
            .runtime
            .block_on(self.root.client.remove_device(&id))
            .map_err(map_client_error)
    }
}

#[cfg(test)]
mod service_error_tests {
    use super::*;
    use beebeeb_api::ApiError;
    use beebeeb_client::ClientError;
    use beebeeb_core::api_error::ServerError;

    fn server(status: u16, body: &str) -> ServiceError {
        map_client_error(ClientError::Api(ApiError::Server(ServerError::parse_body(
            status, body,
        ))))
    }

    #[test]
    fn server_failures_keep_their_typed_binding_cases() {
        assert!(matches!(
            server(409, r#"{"error":"system_folder_managed"}"#),
            ServiceError::ManagedByService
        ));
        assert!(matches!(
            server(507, r#"{"error":"quota_exceeded","limit_bytes":9,"used_bytes":8}"#),
            ServiceError::Quota {
                limit_bytes: Some(9),
                used_bytes: Some(8)
            }
        ));
        assert!(matches!(
            server(499, r#"{"error":"cancelled"}"#),
            ServiceError::Cancelled
        ));
        assert!(matches!(
            server(401, r#"{"error":"session_expired"}"#),
            ServiceError::SessionExpired
        ));
        assert!(matches!(
            server(503, r#"{"error":"busy","retry_after":17}"#),
            ServiceError::RetryAfter { seconds: 17 }
        ));
    }
}
