#[derive(uniffi::Object)]
pub struct ContactServiceHandle {
    root: Arc<NativeClientHandle>,
    store: Arc<StoreHandle>,
}

#[uniffi::export]
impl ContactServiceHandle {
    pub fn observe(&self, contact_id: String, observed_at: i64) -> Result<String, ServiceError> {
        let public_key = self
            .root
            .runtime
            .block_on(self.root.client.fetch_contact_public_key(&contact_id))
            .map_err(map_client_error)?;
        let mut store = self.store.store.lock().map_err(|_| ServiceError::unavailable())?;
        let trust = beebeeb_client::contacts::observe_contact_key(&mut store, &contact_id, &public_key, observed_at)
            .map_err(map_client_error)?;
        Ok(match trust {
            ContactTrust::FirstUse => "first_use",
            ContactTrust::Trusted => "trusted",
            ContactTrust::KeyChanged => "key_changed",
        }
        .into())
    }

    pub fn accept(&self, contact_id: String, observed_at: i64) -> Result<(), ServiceError> {
        let public_key = self
            .root
            .runtime
            .block_on(self.root.client.fetch_contact_public_key(&contact_id))
            .map_err(map_client_error)?;
        let mut store = self.store.store.lock().map_err(|_| ServiceError::unavailable())?;
        beebeeb_client::contacts::accept_contact_key(&mut store, &contact_id, &public_key, observed_at)
            .map_err(map_client_error)
    }
}

#[derive(uniffi::Object)]
pub struct SyncServiceHandle {
    root: Arc<NativeClientHandle>,
    engine: Mutex<beebeeb_client::sync::SyncEngine>,
}

#[uniffi::export]
impl SyncServiceHandle {
    /// First sync, and the authoritative rebase used after an expired local
    /// change window.
    pub fn refresh_snapshot(&self) -> Result<(), ServiceError> {
        let session = self.root.session()?;
        let mut engine = self.engine.lock().map_err(|_| ServiceError::unavailable())?;
        self.root
            .runtime
            .block_on(self.root.client.refresh_sync_snapshot(&session, &mut engine))
            .map_err(map_client_error)
    }

    pub fn recover_gap(&self, catch_up_limit: u16) -> Result<(), ServiceError> {
        let session = self.root.session()?;
        let mut engine = self.engine.lock().map_err(|_| ServiceError::unavailable())?;
        self.root
            .runtime
            .block_on(self.root.client.recover_sync_gap(&session, &mut engine, catch_up_limit))
            .map_err(map_client_error)
    }

    pub fn catch_up(&self, limit: u16) -> Result<(), ServiceError> {
        let session = self.root.session()?;
        let mut engine = self.engine.lock().map_err(|_| ServiceError::unavailable())?;
        self.root
            .runtime
            .block_on(self.root.client.catch_up_sync(&session, &mut engine, limit))
            .map_err(map_client_error)
    }

    pub fn foreground_once(&self, catch_up_limit: u16) -> Result<bool, ServiceError> {
        let session = self.root.session()?;
        let mut engine = self.engine.lock().map_err(|_| ServiceError::unavailable())?;
        self.root
            .runtime
            .block_on(
                self.root
                    .client
                    .foreground_sync_once(&session, &mut engine, catch_up_limit),
            )
            .map_err(map_client_error)
    }
}

#[uniffi::export]
impl NativeClientHandle {
    pub fn uploads(
        self: &Arc<Self>,
        store: Arc<StoreHandle>,
        staging_root: String,
        device_id: String,
        product: String,
    ) -> Result<Arc<UploadServiceHandle>, ServiceError> {
        let service =
            UploadService::new(self.client.clone(), store.store.clone(), staging_root).map_err(map_client_error)?;
        Ok(Arc::new(UploadServiceHandle {
            root: self.clone(),
            service: Arc::new(service),
            store,
            device_id,
            product,
        }))
    }

    pub fn downloads(
        self: &Arc<Self>,
        store: Arc<StoreHandle>,
        cache_root: String,
        cache_limit_bytes: u64,
        memory_class: String,
    ) -> Result<Arc<DownloadServiceHandle>, ServiceError> {
        let budget = MemoryBudget::for_class_code(&memory_class)
            .ok_or_else(|| ServiceError::new(ServiceErrorKind::InvalidInput))?;
        let service = DownloadService::new(
            self.client.clone(),
            store.store.clone(),
            cache_root,
            cache_limit_bytes,
            budget,
        )
        .map_err(map_client_error)?;
        Ok(Arc::new(DownloadServiceHandle {
            root: self.clone(),
            service: Arc::new(service),
        }))
    }

    #[allow(clippy::too_many_arguments)]
    pub fn thumbnails(
        self: &Arc<Self>,
        store: Arc<StoreHandle>,
        codec: Box<dyn ImageCodecCallback>,
        cache_root: String,
        cache_limit_bytes: u64,
        platform_name: String,
        device_id: String,
        product: String,
    ) -> Result<Arc<ThumbnailServiceHandle>, ServiceError> {
        let codec: Arc<dyn ImageCodec> = Arc::new(ImageCodecAdapter { callback: codec });
        let service = ThumbnailService::new(
            self.client.clone(),
            store.store.clone(),
            codec,
            cache_root,
            cache_limit_bytes,
            platform(&platform_name),
        )
        .map_err(map_client_error)?;
        Ok(Arc::new(ThumbnailServiceHandle {
            root: self.clone(),
            service: Arc::new(service),
            store,
            device_id,
            product,
        }))
    }

    pub fn shares(self: &Arc<Self>) -> Arc<ShareServiceHandle> {
        Arc::new(ShareServiceHandle { root: self.clone() })
    }

    pub fn devices(self: &Arc<Self>) -> Arc<DeviceServiceHandle> {
        Arc::new(DeviceServiceHandle { root: self.clone() })
    }

    pub fn contacts(self: &Arc<Self>, store: Arc<StoreHandle>) -> Arc<ContactServiceHandle> {
        Arc::new(ContactServiceHandle {
            root: self.clone(),
            store,
        })
    }

    pub fn settings(self: &Arc<Self>, store: Arc<StoreHandle>) -> Arc<SettingsServiceHandle> {
        Arc::new(SettingsServiceHandle {
            root: self.clone(),
            store,
        })
    }

    pub fn sync(
        self: &Arc<Self>,
        store_path: String,
        device_id: String,
    ) -> Result<Arc<SyncServiceHandle>, ServiceError> {
        let store = Store::open(store_path).map_err(map_client_error)?;
        let engine = beebeeb_client::sync::SyncEngine::with_store_backed(device_id, store).map_err(map_client_error)?;
        Ok(Arc::new(SyncServiceHandle {
            root: self.clone(),
            engine: Mutex::new(engine),
        }))
    }
}

