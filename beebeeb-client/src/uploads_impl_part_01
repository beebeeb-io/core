pub struct UploadService {
    client: Arc<Client>,
    store: Arc<Mutex<Store>>,
    staging_root: PathBuf,
    events: broadcast::Sender<UploadEvent>,
    completion_handler: Mutex<Option<Arc<dyn UploadCompletionHandler>>>,
}

impl UploadService {
    pub fn new(
        client: Arc<Client>,
        store: Arc<Mutex<Store>>,
        staging_root: impl Into<PathBuf>,
    ) -> Result<Self, UploadServiceError> {
        let staging_root = staging_root.into();
        std::fs::create_dir_all(&staging_root).map_err(|_| UploadServiceError::State)?;
        let (events, _) = broadcast::channel(64);
        Ok(Self {
            client,
            store,
            staging_root,
            events,
            completion_handler: Mutex::new(None),
        })
    }

    pub fn set_completion_handler(&self, handler: Arc<dyn UploadCompletionHandler>) -> Result<(), UploadServiceError> {
        *self.completion_handler.lock().map_err(|_| UploadServiceError::State)? = Some(handler);
        Ok(())
    }

    #[cfg(test)]
    pub(crate) fn new_for_test(
        client: Arc<Client>,
        store: Arc<Mutex<Store>>,
        master_key: Arc<beebeeb_core::kdf::MasterKey>,
        staging_root: impl Into<PathBuf>,
    ) -> Result<Self, UploadServiceError> {
        client.set_session_key_for_test(master_key)?;
        Self::new(client, store, staging_root)
    }

    pub fn observe(&self) -> broadcast::Receiver<UploadEvent> {
        self.events.subscribe()
    }

    pub fn enqueue(&self, mut request: UploadRequest, now_ms: i64) -> Result<i64, UploadServiceError> {
        if request.name.is_empty() || request.disk_limit == 0 {
            return Err(UploadServiceError::Source);
        }
        let session_key = self.client.session_key()?;
        if let Some(replacement) = request.replacement.as_mut() {
            let metadata = beebeeb_core::encrypt::decrypt_file_metadata(
                session_key.master_key(),
                &replacement.file_id,
                &replacement.current_version_metadata_encrypted,
            )
            .map_err(|_| UploadServiceError::Encryption)?;
            if metadata.chunk_format != ExpectedChunkFormat::V2 {
                return Err(UploadServiceError::Encryption);
            }
            replacement.previous_version_counter =
                Some(metadata.version.ok_or(UploadServiceError::Encryption)?.counter);
        }
        let source_identity = source_identity(&request.source_path)?;
        let item_id = request
            .replacement
            .is_none()
            .then(|| NewItemId::owner(session_key.master_key()).map_err(|_| UploadServiceError::Encryption))
            .transpose()?;
        if request.replacement.as_ref().is_some_and(|replacement| {
            !matches!(
                beebeeb_core::item_id::item_class(&replacement.file_id),
                Ok(beebeeb_core::item_id::ItemClass::Owner)
            )
        }) {
            return Err(UploadServiceError::Encryption);
        }
        let file_id = match (&request.replacement, &item_id) {
            (Some(replacement), _) => replacement.file_id.clone(),
            (None, Some(item)) => item.as_str().to_owned(),
            (None, None) => return Err(UploadServiceError::Encryption),
        };
        let item_tag = item_id.as_ref().map_or_else(Vec::new, |item| item.tag().to_vec());
        let record = UploadRecord {
            source_path: request.source_path,
            source_identity,
            name: request.name,
            mime_type: request.mime_type,
            parent_id: request.parent_id,
            wifi_only: request.wifi_only,
            disk_limit: request.disk_limit,
            file_id,
            item_tag,
            session_id: None,
            chunk_size: None,
            chunk_count: None,
            planner: None,
            backup_local_identifier: request.backup_local_identifier,
            replacement: request.replacement,
            restart_intent: None,
            remote_completed: false,
            backup_outcome_applied: false,
        };
        let payload = encode_record(&record)?;
        let id = self
            .store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .enqueue_transfer(UPLOAD_KIND, &payload, DEFAULT_MAX_ATTEMPTS, now_ms)
            .map_err(|_| UploadServiceError::State)?;
        self.emit(UploadEvent::Changed {
            id,
            state: TransferState::Queued,
        });
        Ok(id)
    }

    /// Claim and prepare the oldest upload. Initialization, scoped-token
    /// minting, v2 encryption and staging all happen here, not in the platform.
    pub async fn next_transfers(
        &self,
        limit: usize,
        network: NetworkKind,
        now_ms: i64,
    ) -> Result<Option<(i64, Vec<TransferRequest>)>, UploadServiceError> {
        if limit == 0 {
            return Ok(None);
        }
        let lease_until = now_ms.checked_add(LEASE_MS).ok_or(UploadServiceError::State)?;
        let transfer = self
            .store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .claim_transfer_kind(UPLOAD_KIND, now_ms, lease_until)
            .map_err(|_| UploadServiceError::State)?;
        let Some(transfer) = transfer else {
            return Ok(None);
        };
        let mut record = match decode_record(&transfer.payload) {
            Ok(record) => record,
            Err(error) => {
                self.record_attempt_failure(transfer.id, "upload state is invalid", now_ms)?;
                return Err(error);
            }
        };
        if !(TransferRule {
            wifi_only: record.wifi_only,
        })
        .allows(network)
        {
            self.release(transfer.id, now_ms)?;
            return Ok(Some((transfer.id, Vec::new())));
        }

        if record.restart_intent.is_some() {
            let _current_source = match source_identity(&record.source_path) {
                Ok(source) => source,
                Err(error) => {
                    self.record_attempt_failure(transfer.id, "upload source is unavailable", now_ms)?;
                    return Err(error);
                }
            };
            self.finish_restart_intent(transfer.id, &mut record, now_ms).await?;
            self.release(transfer.id, now_ms)?;
            self.emit(UploadEvent::SourceChanged { id: transfer.id });
            return Err(UploadServiceError::SourceChangedRestarted);
        }
        if record.planner.is_none() && record.session_id.is_some() {
            let current_source = match source_identity(&record.source_path) {
                Ok(source) => source,
                Err(error) => {
                    self.record_attempt_failure(transfer.id, "upload source is unavailable", now_ms)?;
                    return Err(error);
                }
            };
            let plan = BackgroundRestartPlan {
                file_id: record.file_id.clone(),
                upload_session_id: record.session_id.clone().ok_or(UploadServiceError::State)?,
                cleanup: SignOutPlan {
                    cancel_tickets: Vec::new(),
                    delete_files: staged_files(&self.upload_directory(transfer.id)),
                },
            };
            self.begin_restart(transfer.id, &mut record, &plan, current_source, now_ms)
                .await?;
            self.release(transfer.id, now_ms)?;
            return Err(UploadServiceError::SourceChangedRestarted);
        }
        let session_key = self.client.session_key()?;
        let mut planner = match record.planner.as_deref() {
            Some(bytes) => {
                let restored = match source_identity(&record.source_path) {
                    Ok(current_source) => {
                        BackgroundUploadPlanner::from_bytes(bytes, &self.upload_directory(transfer.id), &current_source)
                    }
                    Err(_) => {
                        BackgroundUploadPlanner::from_bytes_after_staging(bytes, &self.upload_directory(transfer.id))
                    }
                };
                let restored = match restored {
                    Ok(restored) => restored,
                    Err(error) => {
                        self.record_attempt_failure(transfer.id, "upload state is invalid", now_ms)?;
                        return Err(map_background(error));
                    }
                };
                match restored {
                    BackgroundRestore::Resumed(planner) => {
                        if !planner.all_chunks_staged()
                            && !planner
                                .staged_plaintext_matches(
                                    File::open(&record.source_path).map_err(|_| UploadServiceError::Source)?,
                                )
                                .map_err(map_background)?
                        {
                            let plan = planner.restart_plan();
                            let current_source = source_identity(&record.source_path)?;
                            self.begin_restart(transfer.id, &mut record, &plan, current_source, now_ms)
                                .await?;
                            self.release(transfer.id, now_ms)?;
                            self.emit(UploadEvent::SourceChanged { id: transfer.id });
                            return Err(UploadServiceError::SourceChangedRestarted);
                        }
                        planner
                    }
                    BackgroundRestore::AbandonAndRestart(plan) => {
                        let current_source = source_identity(&record.source_path)?;
                        self.begin_restart(transfer.id, &mut record, &plan, current_source, now_ms)
                            .await?;
                        self.release(transfer.id, now_ms)?;
                        self.emit(UploadEvent::SourceChanged { id: transfer.id });
                        return Err(UploadServiceError::SourceChangedRestarted);
                    }
                }
            }
            None => match self.initialize(transfer.id, &mut record, &session_key, now_ms).await {
                Ok(planner) => planner,
                Err(error) => {
                    if upload_upgrade_required(&error) {
                        self.mark_upgrade_required(transfer.id, now_ms)?;
                    } else if matches!(
                        error,
                        UploadServiceError::QuotaFull | UploadServiceError::HostileChunkPlan
                    ) {
                        self.store
                            .lock()
                            .map_err(|_| UploadServiceError::State)?
                            .mark_transfer_failed(transfer.id, "upload cannot be started", now_ms)
                            .map_err(|_| UploadServiceError::State)?;
                    } else {
                        self.record_attempt_failure(transfer.id, "upload initialization failed", now_ms)?;
                    }
                    return Err(error);
                }
            },
        };

        let stage_result = self.stage_more(&record, &mut planner, &session_key);
        if stage_result.is_ok() && !planner.staged_plaintext_hash_complete() {
            let source = File::open(&record.source_path).map_err(|_| UploadServiceError::Source)?;
            if let Err(error) = planner.record_staged_plaintext_hash(source).map_err(map_background) {
                record.planner = Some(planner.to_bytes().map_err(map_background)?);
                self.persist(transfer.id, &record, now_ms)?;
                self.record_attempt_failure(transfer.id, "upload source hashing failed", now_ms)?;
                return Err(error);
            }
        }
        record.planner = Some(planner.to_bytes().map_err(map_background)?);
        self.persist(transfer.id, &record, now_ms)?;
        let stage_generation = match stage_result {
            Ok(generation) => generation,
            Err(error) => {
                self.record_attempt_failure(transfer.id, "upload staging failed", now_ms)?;
                return Err(error);
            }
        };
        if planner.all_chunks_staged() && planner.remaining_chunks() == 0 {
            if let Err(error) = self
                .finish_completed_upload(transfer.id, &mut record, &planner, now_ms)
                .await
            {
                if upload_upgrade_required(&error) {
                    self.mark_upgrade_required(transfer.id, now_ms)?;
                } else {
                    self.record_attempt_failure(transfer.id, "upload completion failed", now_ms)?;
                }
                return Err(error);
            }
            return Ok(Some((transfer.id, Vec::new())));
        }
        let token = match self
            .client
            .execute_for_generation(
                &beebeeb_api::proposed::mint_upload_token(
                    record.session_id.as_deref().ok_or(UploadServiceError::State)?,
                ),
                &(),
                stage_generation,
            )
            .await
        {
            Ok(token) => token,
            Err(error) => {
                if client_upgrade_required(&error) {
                    self.mark_upgrade_required(transfer.id, now_ms)?;
                } else {
                    self.record_attempt_failure(transfer.id, "upload token mint failed", now_ms)?;
                }
                return Err(error.into());
            }
        };
        if token.upload_session_id != record.session_id.as_deref().ok_or(UploadServiceError::State)? {
            self.record_attempt_failure(transfer.id, "upload token did not match its session", now_ms)?;
            return Err(UploadServiceError::HostileChunkPlan);
        }
        let requests = planner.next_transfers(limit, &token.token, u64::try_from(now_ms).unwrap_or(0));
        record.planner = Some(planner.to_bytes().map_err(map_background)?);
        self.persist(transfer.id, &record, now_ms)?;
        if requests.is_empty() {
            self.release(transfer.id, now_ms)?;
            self.emit(UploadEvent::Changed {
                id: transfer.id,
                state: TransferState::Queued,
            });
        } else {
            self.emit(UploadEvent::Changed {
                id: transfer.id,
                state: TransferState::Running,
            });
        }
        Ok(Some((transfer.id, requests)))
    }

    #[allow(clippy::too_many_arguments)]
    pub async fn transfer_finished(
        &self,
        id: i64,
        ticket: &str,
        status: u16,
        content_type: Option<&str>,
        retry_after: Option<&str>,
        body: &[u8],
        now_ms: i64,
    ) -> Result<TransferFinished, UploadServiceError> {
        let transfer = self.transfer(id)?;
        let mut record = decode_record(&transfer.payload)?;
        let bytes = record.planner.as_deref().ok_or(UploadServiceError::State)?;
        let restored = match source_identity(&record.source_path) {
            Ok(current) => BackgroundUploadPlanner::from_bytes(bytes, &self.upload_directory(id), &current),
            Err(_) => BackgroundUploadPlanner::from_bytes_after_staging(bytes, &self.upload_directory(id)),
        }
        .map_err(map_background)?;
        let mut planner = match restored {
            BackgroundRestore::Resumed(planner) => planner,
            BackgroundRestore::AbandonAndRestart(plan) => {
                let current = source_identity(&record.source_path)?;
                self.begin_restart(id, &mut record, &plan, current, now_ms).await?;
                return Err(UploadServiceError::SourceChangedRestarted);
            }
        };
        let result = planner.transfer_finished(
            ticket,
            status,
            content_type,
            retry_after,
            body,
            u64::try_from(now_ms).unwrap_or(0),
        );
        if matches!(result, TransferFinished::UploadTokenExpired { .. }) {
            self.emit(UploadEvent::TokenExpired { id });
        }
        if matches!(result, TransferFinished::Failed { .. }) {
            self.store
                .lock()
                .map_err(|_| UploadServiceError::State)?
                .mark_transfer_failed(id, "upload failed", now_ms)
                .map_err(|_| UploadServiceError::State)?;
            self.emit(UploadEvent::Changed {
                id,
                state: TransferState::Failed,
            });
        } else if matches!(result, TransferFinished::Committed { .. })
            && planner.all_chunks_staged()
            && planner.remaining_chunks() == 0
        {
            record.planner = Some(planner.to_bytes().map_err(map_background)?);
            self.persist(id, &record, now_ms)?;
            if let Err(error) = self.finish_completed_upload(id, &mut record, &planner, now_ms).await {
                if upload_upgrade_required(&error) {
                    self.mark_upgrade_required(id, now_ms)?;
                } else {
                    self.record_attempt_failure(id, "upload completion failed", now_ms)?;
                }
                return Err(error);
            }
        } else {
            record.planner = Some(planner.to_bytes().map_err(map_background)?);
            self.persist(id, &record, now_ms)?;
            self.release(id, now_ms)?;
        }
        Ok(result)
    }

    pub fn pause(&self, id: i64, now_ms: i64) -> Result<bool, UploadServiceError> {
        let changed = self
            .store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .pause_transfer(id, now_ms)
            .map_err(|_| UploadServiceError::State)?;
        if changed {
            self.emit(UploadEvent::Changed {
                id,
                state: TransferState::Paused,
            });
        }
        Ok(changed)
    }

    pub fn resume(&self, id: i64, now_ms: i64) -> Result<bool, UploadServiceError> {
        let changed = self
            .store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .resume_transfer(id, now_ms)
            .map_err(|_| UploadServiceError::State)?;
        if changed {
            self.emit(UploadEvent::Changed {
                id,
                state: TransferState::Queued,
            });
        }
        Ok(changed)
    }

    pub fn cancel(&self, id: i64, now_ms: i64) -> Result<SignOutPlan, UploadServiceError> {
        let transfer = self.transfer(id)?;
        let record = decode_record(&transfer.payload)?;
        let mut plan = SignOutPlan {
            cancel_tickets: Vec::new(),
            delete_files: Vec::new(),
        };
        if let Some(bytes) = record.planner.as_deref() {
            let current = source_identity(&record.source_path).unwrap_or(record.source_identity.clone());
            plan = match BackgroundUploadPlanner::from_bytes(bytes, &self.upload_directory(id), &current)
                .map_err(map_background)?
            {
                BackgroundRestore::Resumed(mut planner) => planner.sign_out(),
                BackgroundRestore::AbandonAndRestart(restart) => restart.cleanup,
            };
        }
        self.store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .cancel_transfer(id, now_ms)
            .map_err(|_| UploadServiceError::State)?;
        self.emit(UploadEvent::Changed {
            id,
            state: TransferState::Cancelled,
        });
        Ok(plan)
    }

    pub fn list(&self) -> Result<Vec<UploadSummary>, UploadServiceError> {
        self.store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .transfers(Some(UPLOAD_KIND))
            .map_err(|_| UploadServiceError::State)?
            .into_iter()
            .map(|transfer| {
                let record = decode_record(&transfer.payload)?;
                Ok(UploadSummary {
                    id: transfer.id,
                    file_id: record.file_id,
                    name: record.name,
                    state: transfer.state,
                    attempts: transfer.attempts,
                    last_error: transfer.last_error,
                })
            })
            .collect()
    }

    pub fn pending_backup_outcomes(&self) -> Result<Vec<BackupUploadOutcome>, UploadServiceError> {
        let outcomes = self
            .store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .transfers(Some(UPLOAD_KIND))
            .map_err(|_| UploadServiceError::State)?
            .into_iter()
            .filter_map(|transfer| {
                let record = decode_record(&transfer.payload).ok()?;
                let local_identifier = record.backup_local_identifier?;
                if record.backup_outcome_applied {
                    return None;
                }
                let kind = match transfer.state {
                    TransferState::Succeeded if record.remote_completed => BackupUploadOutcomeKind::Completed,
                    TransferState::Failed => BackupUploadOutcomeKind::Failed,
                    TransferState::Cancelled => BackupUploadOutcomeKind::Cancelled,
                    _ => return None,
                };
                Some(BackupUploadOutcome {
                    upload_id: transfer.id,
                    local_identifier,
                    file_id: record.file_id,
                    kind,
                })
            })
            .collect();
        Ok(outcomes)
    }

    pub fn active_backup_count(&self) -> Result<usize, UploadServiceError> {
        let count = self
            .store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .transfers(Some(UPLOAD_KIND))
            .map_err(|_| UploadServiceError::State)?
            .into_iter()
            .filter(|transfer| {
                matches!(
                    transfer.state,
                    TransferState::Queued | TransferState::Running | TransferState::Paused
                ) && decode_record(&transfer.payload)
                    .ok()
                    .is_some_and(|record| record.backup_local_identifier.is_some())
            })
            .count();
        Ok(count)
    }

    pub fn mark_backup_outcome_applied(&self, id: i64, now_ms: i64) -> Result<(), UploadServiceError> {
        let transfer = self.transfer(id)?;
        let mut record = decode_record(&transfer.payload)?;
        if record.backup_local_identifier.is_none() {
            return Err(UploadServiceError::State);
        }
        record.backup_outcome_applied = true;
        let payload = encode_record(&record)?;
        if !self
            .store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .update_final_transfer_payload(id, &payload, now_ms)
            .map_err(|_| UploadServiceError::State)?
        {
            return Err(UploadServiceError::NotActive);
        }
        Ok(())
    }

    /// Stop and discard every account-bound upload before store deletion.
    pub fn sign_out(&self, now_ms: i64) -> Result<SignOutPlan, UploadServiceError> {
        let ids: Vec<i64> = self.list()?.into_iter().map(|item| item.id).collect();
        let mut combined = SignOutPlan {
            cancel_tickets: Vec::new(),
            delete_files: Vec::new(),
        };
        for id in ids {
            if let Ok(plan) = self.cancel(id, now_ms) {
                combined.cancel_tickets.extend(plan.cancel_tickets);
                combined.delete_files.extend(plan.delete_files);
            }
        }
        Ok(combined)
    }

    /// Delete staged ciphertext after the platform has consumed the returned
    /// cancellation tickets. Repeating this is harmless.
    pub fn finalize_sign_out(&self, plan: &SignOutPlan) {
        remove_planned_files(plan);
    }

    async fn initialize(
        &self,
        id: i64,
        record: &mut UploadRecord,
        session_key: &crate::SessionKey,
        now_ms: i64,
    ) -> Result<BackgroundUploadPlanner, UploadServiceError> {
        let preliminary_name = if let Some(replacement) = &record.replacement {
            replacement.current_version_metadata_encrypted.clone()
        } else {
            let item = NewItemId::resume(session_key.master_key(), &record.file_id, &record.item_tag)
                .map_err(|_| UploadServiceError::Encryption)?;
            encrypt_name_for_new_item(
                session_key.master_key(),
                &item,
                &record.name,
                record.mime_type.as_deref(),
                ExpectedChunkFormat::V2,
            )
            .map_err(|_| UploadServiceError::Encryption)?
        };
        let request = InitRequest {
            file_id: Some(record.file_id.clone()),
            file_name: preliminary_name,
            file_size_bytes: record.source_identity.size_bytes,
            parent_id: record.parent_id.clone(),
            profile: beebeeb_types::ChunkProfile::Mobile,
            preferred_region: None,
            chunk_size_bytes: None,
            chunk_count: None,
            is_media: record
                .mime_type
                .as_deref()
                .is_some_and(|value| value.starts_with("image/") || value.starts_with("video/")),
            base_version_number: record
                .replacement
                .as_ref()
                .map(|replacement| replacement.base_version_number),
            created_at: None,
            conflict_created: false,
            version_metadata_encrypted: record
                .replacement
                .as_ref()
                .map(|replacement| replacement.current_version_metadata_encrypted.clone()),
        };
        let response = match self
            .client
            .execute_for_generation(
                &beebeeb_api::routes::uploads::init(),
                &request,
                session_key.generation(),
            )
            .await
        {
            Ok(response) => response,
            Err(ClientError::Api(beebeeb_api::ApiError::Server(error)))
                if error.is_code("quota_exceeded") || error.is_trial_cap() || error.status == 507 =>
            {
                self.emit(UploadEvent::QuotaFull { id });
                return Err(UploadServiceError::QuotaFull);
            }
            Err(error) => return Err(error.into()),
        };
        if !session_key.is_current(&self.client) {
            return Err(ClientError::StaleAccount.into());
        }
        let chunk_count = validate_geometry(
            record.source_identity.size_bytes,
            response.chunk_size_bytes,
            response.chunk_count,
        )?;
        if response.file_id != record.file_id || response.upload_session_id.is_empty() {
            return Err(UploadServiceError::HostileChunkPlan);
        }
        let directory = self.upload_directory(id);
        std::fs::create_dir_all(&directory).map_err(|_| UploadServiceError::State)?;
        let planner = BackgroundUploadPlanner::new(
            id.to_string(),
            response.upload_session_id.clone(),
            record.file_id.clone(),
            directory,
            record.disk_limit,
            response.chunk_size_bytes,
            chunk_count,
            record.source_identity.clone(),
        )
        .map_err(map_background)?;
        record.session_id = Some(response.upload_session_id);
        record.chunk_size = Some(response.chunk_size_bytes);
        record.chunk_count = Some(chunk_count);
        self.persist(id, record, now_ms)?;
        Ok(planner)
    }

    fn stage_more(
        &self,
        record: &UploadRecord,
        planner: &mut BackgroundUploadPlanner,
        session_key: &crate::SessionKey,
    ) -> Result<u64, UploadServiceError> {
        if planner.all_chunks_staged() {
            return Ok(session_key.generation());
        }
        let file = File::open(&record.source_path).map_err(|_| UploadServiceError::Source)?;
        let chunk_size = record.chunk_size.ok_or(UploadServiceError::State)?;
        let chunk_count = record.chunk_count.ok_or(UploadServiceError::State)?;
        let mut encryptor = if planner.version_commitment().is_some() {
            planner
                .resume_encryptor(session_key.master_key(), file)
                .map_err(map_background)?
        } else {
            ChunkEncryptor::from_reader_with_chunk_size(
                session_key.master_key(),
                &record.file_id,
                record.source_identity.size_bytes,
                chunk_size,
                file,
            )
            .map_err(|_| UploadServiceError::Encryption)?
        };
        let start = encryptor.chunks_emitted();
        let session = record.session_id.as_deref().ok_or(UploadServiceError::State)?;
        let grants: Vec<_> = (start..chunk_count)
            .map(|index| BackgroundGrant {
                index,
                url: format!("/api/v1/uploads/{session}/chunks/{index}"),
                headers: vec![("Content-Type".into(), "application/octet-stream".into())],
                commit_path: None,
                requires_upload_token: true,
            })
            .collect();
        let progress = planner
            .stage_available(
                &mut encryptor,
                &grants,
                record
                    .replacement
                    .as_ref()
                    .and_then(|replacement| replacement.previous_version_counter),
            )
            .map_err(map_background)?;
        if progress.staged == 0 && !progress.all_chunks_staged && planner.remaining_chunks() == 0 {
            return Err(UploadServiceError::State);
        }
        if progress.all_chunks_staged {
            planner.finish_encryption(encryptor).map_err(map_background)?;
        }
        if !session_key.is_current(&self.client) {
            return Err(ClientError::StaleAccount.into());
        }
        Ok(session_key.generation())
    }

    async fn complete(
        &self,
        id: i64,
        record: &UploadRecord,
        planner: &BackgroundUploadPlanner,
    ) -> Result<(), UploadServiceError> {
        let session_key = self.client.session_key()?;
        let version = planner.version_commitment().ok_or(UploadServiceError::Encryption)?;
        let name_encrypted = if record.replacement.is_some() {
            #[allow(deprecated)]
            beebeeb_core::encrypt::encrypt_name_with_version(
                session_key.master_key(),
                &record.file_id,
                &record.name,
                record.mime_type.as_deref(),
                ExpectedChunkFormat::V2,
                version,
            )
            .map_err(|_| UploadServiceError::Encryption)?
        } else {
            let item = NewItemId::resume(session_key.master_key(), &record.file_id, &record.item_tag)
                .map_err(|_| UploadServiceError::Encryption)?;
            encrypt_name_for_new_item_version(
                session_key.master_key(),
                &item,
                &record.name,
                record.mime_type.as_deref(),
                ExpectedChunkFormat::V2,
                version,
            )
            .map_err(|_| UploadServiceError::Encryption)?
        };
        let request = CompleteRequest {
            name_encrypted: Some(name_encrypted.clone()),
            version_metadata_encrypted: Some(name_encrypted),
        };
        self.client
            .execute_for_generation(
                &beebeeb_api::routes::uploads::complete(record.session_id.as_deref().ok_or(UploadServiceError::State)?),
                &request,
                session_key.generation(),
            )
            .await?;
        if !session_key.is_current(&self.client) {
            return Err(ClientError::StaleAccount.into());
        }
        let _ = std::fs::remove_dir(self.upload_directory(id));
        Ok(())
    }

    async fn finish_completed_upload(
        &self,
        id: i64,
        record: &mut UploadRecord,
        planner: &BackgroundUploadPlanner,
        now_ms: i64,
    ) -> Result<(), UploadServiceError> {
        let generation = self.client.generation();
        if !record.remote_completed {
            self.complete(id, record, planner).await?;
            record.remote_completed = true;
            self.persist(id, record, now_ms)?;
        }
        if generation != self.client.generation() {
            return Err(ClientError::StaleAccount.into());
        }
        if let Some(local_identifier) = record.backup_local_identifier.as_deref() {
            let handler = self
                .completion_handler
                .lock()
                .map_err(|_| UploadServiceError::State)?
                .clone();
            if let Some(handler) = handler {
                handler
                    .completed(local_identifier, &record.file_id)
                    .await
                    .map_err(|_| UploadServiceError::State)?;
                if generation != self.client.generation() {
                    return Err(ClientError::StaleAccount.into());
                }
                record.backup_outcome_applied = true;
                self.persist(id, record, now_ms)?;
            }
        }
        self.mark_succeeded(id, now_ms)
    }

    async fn begin_restart(
        &self,
        id: i64,
        record: &mut UploadRecord,
        plan: &BackgroundRestartPlan,
        source_identity: UploadSourceIdentity,
        now_ms: i64,
    ) -> Result<(), UploadServiceError> {
        record.restart_intent = Some(RestartIntent {
            source_identity,
            file_id: plan.file_id.clone(),
            upload_session_id: plan.upload_session_id.clone(),
            delete_files: plan.cleanup.delete_files.clone(),
        });
        self.persist(id, record, now_ms)?;
        self.finish_restart_intent(id, record, now_ms).await
    }

    async fn finish_restart_intent(
        &self,
        id: i64,
        record: &mut UploadRecord,
        now_ms: i64,
    ) -> Result<(), UploadServiceError> {
        let intent = record.restart_intent.clone().ok_or(UploadServiceError::State)?;
        if let Err(error) = self
            .client
            .execute(&beebeeb_api::routes::uploads::abandon(&intent.file_id), &())
            .await
            .map(|_: beebeeb_api::routes::uploads::AbandonResponse| ())
        {
            if client_upgrade_required(&error) {
                self.mark_upgrade_required(id, now_ms)?;
            } else {
                self.record_attempt_failure(id, "upload restart abandon failed", now_ms)?;
            }
            return Err(error.into());
        }
        for path in &intent.delete_files {
            let _ = std::fs::remove_file(path);
        }
        record.source_identity = intent.source_identity;
        record.session_id = None;
        record.chunk_size = None;
        record.chunk_count = None;
        record.planner = None;
        record.restart_intent = None;
        self.persist(id, record, now_ms)
    }

    fn upload_directory(&self, id: i64) -> PathBuf {
        self.staging_root.join(format!("upload-{id}"))
    }

    fn transfer(&self, id: i64) -> Result<beebeeb_store::Transfer, UploadServiceError> {
        self.store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .transfer(id)
            .map_err(|_| UploadServiceError::State)?
            .ok_or(UploadServiceError::NotActive)
    }

    fn persist(&self, id: i64, record: &UploadRecord, now_ms: i64) -> Result<(), UploadServiceError> {
        let payload = encode_record(record)?;
        if !self
            .store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .update_transfer_payload(id, &payload, now_ms)
            .map_err(|_| UploadServiceError::State)?
        {
            return Err(UploadServiceError::NotActive);
        }
        Ok(())
    }

    fn release(&self, id: i64, now_ms: i64) -> Result<(), UploadServiceError> {
        self.store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .release_transfer(id, now_ms)
            .map_err(|_| UploadServiceError::State)?;
        Ok(())
    }

    fn record_attempt_failure(&self, id: i64, message: &str, now_ms: i64) -> Result<(), UploadServiceError> {
        let transfer = self
            .store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .record_transfer_failure(id, message, now_ms)
            .map_err(|_| UploadServiceError::State)?;
        self.emit(UploadEvent::Changed {
            id,
            state: transfer.state,
        });
        Ok(())
    }

    fn mark_upgrade_required(&self, id: i64, now_ms: i64) -> Result<(), UploadServiceError> {
        self.store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .mark_transfer_failed(id, "client upgrade required (HTTP 426)", now_ms)
            .map_err(|_| UploadServiceError::State)?;
        self.emit(UploadEvent::Changed {
            id,
            state: TransferState::Failed,
        });
        Ok(())
    }

    fn mark_succeeded(&self, id: i64, now_ms: i64) -> Result<(), UploadServiceError> {
        self.store
            .lock()
            .map_err(|_| UploadServiceError::State)?
            .mark_transfer_succeeded(id, now_ms)
            .map_err(|_| UploadServiceError::State)?;
        self.emit(UploadEvent::Changed {
            id,
            state: TransferState::Succeeded,
        });
        Ok(())
    }

    fn emit(&self, event: UploadEvent) {
        let _ = self.events.send(event);
    }
}

fn source_identity(path: &Path) -> Result<UploadSourceIdentity, UploadServiceError> {
    let metadata = std::fs::metadata(path).map_err(|_| UploadServiceError::Source)?;
    if !metadata.is_file() {
        return Err(UploadServiceError::Source);
    }
    let modified = metadata.modified().unwrap_or(SystemTime::UNIX_EPOCH);
    let modified_unix_ms = match modified.duration_since(UNIX_EPOCH) {
        Ok(duration) => i64::try_from(duration.as_millis()).unwrap_or(i64::MAX),
        Err(_) => 0,
    };
    Ok(UploadSourceIdentity {
        size_bytes: metadata.len(),
        modified_unix_ms,
        content_hash: None,
    })
}

fn staged_files(directory: &Path) -> Vec<PathBuf> {
    let Ok(entries) = std::fs::read_dir(directory) else {
        return Vec::new();
    };
    entries
        .filter_map(Result::ok)
        .map(|entry| entry.path())
        .filter(|path| path.is_file())
        .collect()
}

fn validate_geometry(file_size: u64, chunk_size: u64, chunk_count: u64) -> Result<u32, UploadServiceError> {
    if chunk_size == 0 || chunk_size > MAX_CHUNK_SIZE {
        return Err(UploadServiceError::HostileChunkPlan);
    }
    let expected = if file_size == 0 {
        1
    } else {
        file_size
            .checked_sub(1)
            .and_then(|value| value.checked_div(chunk_size))
            .and_then(|value| value.checked_add(1))
            .ok_or(UploadServiceError::HostileChunkPlan)?
    };
    if chunk_count != expected {
        return Err(UploadServiceError::HostileChunkPlan);
    }
    u32::try_from(chunk_count).map_err(|_| UploadServiceError::HostileChunkPlan)
}

fn encode_record(record: &UploadRecord) -> Result<Vec<u8>, UploadServiceError> {
    serde_json::to_vec(record).map_err(|_| UploadServiceError::State)
}
fn decode_record(bytes: &[u8]) -> Result<UploadRecord, UploadServiceError> {
    serde_json::from_slice(bytes).map_err(|_| UploadServiceError::State)
}
fn map_background(_error: BackgroundError) -> UploadServiceError {
    UploadServiceError::State
}

fn client_upgrade_required(error: &ClientError) -> bool {
    matches!(
        error,
        ClientError::Api(beebeeb_api::ApiError::Server(server)) if server.status == 426
    )
}

fn upload_upgrade_required(error: &UploadServiceError) -> bool {
    matches!(error, UploadServiceError::Client(error) if client_upgrade_required(error))
}
fn remove_planned_files(plan: &SignOutPlan) {
    for path in &plan.delete_files {
        let _ = std::fs::remove_file(path);
    }
}
