{
  "description": "Move 7 \u2014 the server's two-field error contract ({\"error\": <stable code>, \"message\": <human text>}) decoded once, plus the predicates clients branch on. The typed error keeps the whole parsed body, so quota fields (is_trial_cap, limit_bytes, used_bytes) and any future additive field survive.",
  "source": "server beebeeb-api/src/error.rs contract; web packages/shared/src/api/errors.ts parseErrorBody/readErrorResponse (double-encoded unwrap), cli src/api.rs parse_response_typed + is_code + upload_session_gone, desktop api_client.rs check_status (which discards the code today); mobile's quota branches on is_trial_cap/limit_bytes per the map \u00a75.3 move 7",
  "cases": [
    {
      "id": "error_body_quota_exceeded",
      "kind": "body",
      "status": 413,
      "payload": "{\"error\":\"quota_exceeded\",\"message\":\"Storage full\",\"limit_bytes\":1000,\"used_bytes\":900}",
      "expected": {
        "code": "quota_exceeded",
        "message": "Storage full",
        "status_is_error": true,
        "session_gone_404": false,
        "session_gone_strict": false,
        "retry_after": null,
        "is_trial_cap": false,
        "limit_bytes": 1000,
        "used_bytes": 900,
        "is_code": [
          "quota_exceeded"
        ],
        "not_code": [
          "quota",
          "QUOTA_EXCEEDED"
        ],
        "details_preserved": [
          "limit_bytes",
          "used_bytes"
        ]
